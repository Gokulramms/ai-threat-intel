# =============================================================================
# OpenKai Enterprise Security Platform - Environment Configuration
# =============================================================================

# --- Environment & Security ---
ENVIRONMENT=production                 # development | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARN | ERROR
OPENKAI_SECRET_KEY=change-this-to-a-secure-random-64-char-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
# Default: Local asynchronous SQLite database
DATABASE_URL=sqlite+aiosqlite:///openkai_data.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://openkai_user:password@localhost:5432/openkai_db

# --- AI & LLM Engine ---
# Primary: Google Gemini AI
LLM_PROVIDER=gemini                    # gemini | ollama | openai | anthropic
GEMINI_API_KEY=                        # Your Google Gemini API Key from Google AI Studio
GEMINI_MODEL=gemini-1.5-flash          # gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash

# Self-Hosted / Local LLM Alternative (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- CrowdStrike Falcon EDR Integration ---
# Official CrowdStrike API Credentials
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# --- Elastic SIEM / Elasticsearch Integration ---
# Official Elasticsearch 8.x+ or 7.x Cluster
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_INDEX=logs-*,security-*,audit-*

# --- Threat Intelligence Feed Credentials ---
# Sources requiring API Keys:
VIRUSTOTAL_API_KEY=                    # Free community or Enterprise key
ABUSEIPDB_API_KEY=                     # Free tier key (1000 queries/day)
OTX_API_KEY=                           # AlienVault OTX free API key
NVD_API_KEY=                           # Optional: increases NIST NVD rate limit

# Sources that are 100% Free Public Feeds (No API Keys needed):
# 1. CISA Known Exploited Vulnerabilities (KEV)
# 2. MITRE ATT&CK Enterprise Matrix
# 3. abuse.ch ThreatFox
# 4. abuse.ch URLhaus
# 5. abuse.ch MalwareBazaar
# 6. CERT-In Security Advisories
# 7. ENISA Cybersecurity Publications
# 8. UK NCSC Alerts
# 9. JPCERT/CC Advisories
# 10. CISA Alerts & Advisories

# --- Security Notifications & Alerting ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Background Sync Intervals (Minutes) ---
TI_SYNC_INTERVAL_MINUTES=60
CROWDSTRIKE_SYNC_INTERVAL_MINUTES=30
ELASTIC_SYNC_INTERVAL_MINUTES=15
